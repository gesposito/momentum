{
  "name": "@momentum-js/momentum",
  "version": "0.1.0",
  "description": "Luxon-compatible immutable dates, durations and intervals, powered by Temporal",
  "keywords": [
    "date",
    "time",
    "temporal",
    "luxon",
    "immutable",
    "timezone"
  ],
  "homepage": "https://github.com/gesposito/momentum#readme",
  "bugs": "https://github.com/gesposito/momentum/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gesposito/momentum.git"
  },
  "license": "MIT",
  "author": "Gianluca Esposito <g@esposi.to>",
  "type": "module",
  "sideEffects": [
    "./src/polyfill.ts",
    "./build/polyfill.js"
  ],
  "main": "./build/momentum.js",
  "types": "./build/types/momentum.d.ts",
  "exports": {
    ".": {
      "types": "./build/types/momentum.d.ts",
      "default": "./build/momentum.js"
    },
    "./polyfill": {
      "types": "./build/types/polyfill.d.ts",
      "default": "./build/polyfill.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "build",
    "src",
    "LICENSE.md",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun run build:js && bun run build:types",
    "build:js": "bun scripts/build.ts",
    "build:types": "tsc -p tsconfig.build.json",
    "build:migrate": "bun scripts/build-migrate.ts",
    "typecheck": "bun check && bun check -p migrate",
    "migrate": "bun migrate/cli.ts",
    "test": "TZ=America/New_York LANG=en_US.utf8 jest --coverage",
    "test:polyfill": "MOMENTUM_TEMPORAL=polyfill TZ=America/New_York LANG=en_US.utf8 jest",
    "test:opt-out": "MOMENTUM_TEMPORAL_NATIVE=false TZ=America/New_York LANG=en_US.utf8 jest",
    "jest": "TZ=America/New_York LANG=en_US.utf8 jest",
    "test:bun": "bun scripts/test-bun.ts",
    "test:dayjs-zones": "bun scripts/test-dayjs-zones.ts",
    "test:dayjs-suite": "bun scripts/test-dayjs-suite.ts",
    "benchmark": "bun run build:js && bun benchmarks/index.ts",
    "benchmark:compare": "bun run build:js && bun benchmarks/index.ts --compare",
    "benchmark:node": "bun run build:js && node --expose-gc benchmarks/index.ts --compare",
    "benchmark:memory": "bun run build:js && bun benchmarks/memory.ts",
    "benchmark:memory:node": "bun run build:js && node --expose-gc benchmarks/memory.ts",
    "sync-tests": "bun scripts/sync-tests.ts",
    "sync-dayjs": "bun scripts/sync-dayjs.ts",
    "prepack": "bun run build"
  },
  "dependencies": {
    "temporal-spec": "^1.0.1"
  },
  "peerDependencies": {
    "temporal-polyfill": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "temporal-polyfill": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-typescript": "^7.27.0",
    "@types/bun": "^1.4.3",
    "babel-jest": "^29.7.0",
    "dayjs": "^1.11.23",
    "fast-check": "^4.10.2",
    "jest": "^29.7.0",
    "luxon": "^3.7.2",
    "mitata": "^1.0.34",
    "mockdate": "2.0.5",
    "moment": "2.29.2",
    "moment-timezone": "0.5.31",
    "temporal-polyfill": "^1.0.6",
    "typescript": "^7.0.2"
  }
}
