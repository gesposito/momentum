{
  "name": "momentum",
  "private": true,
  "description": "Luxon-compatible dates on Temporal, Day.js as a reference, and the migration tool to native Temporal",
  "license": "MIT",
  "author": "Gianluca Esposito <g@esposi.to>",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "bun run build:luxon && bun run build:migrate",
    "build:luxon": "bun run --cwd packages/luxon build",
    "build:migrate": "bun run --cwd packages/migrate build",
    "typecheck": "bun check -p packages/luxon && bun check -p packages/migrate",
    "migrate": "bun packages/migrate/src/cli.ts",
    "test": "TZ=America/New_York LANG=en_US.utf8 jest --coverage",
    "test:polyfill": "MOMENTUM_TEMPORAL=polyfill TZ=America/New_York LANG=en_US.utf8 jest",
    "test:opt-out": "MOMENTUM_TEMPORAL_NATIVE=false TZ=America/New_York LANG=en_US.utf8 jest",
    "jest": "TZ=America/New_York LANG=en_US.utf8 jest",
    "test:bun": "bun scripts/test-bun.ts",
    "test:dayjs-zones": "bun packages/migrate/scripts/test-dayjs-zones.ts",
    "test:dayjs-suite": "bun packages/migrate/scripts/test-dayjs-suite.ts",
    "benchmark": "bun run --cwd packages/luxon benchmark",
    "benchmark:compare": "bun run --cwd packages/luxon benchmark:compare",
    "benchmark:node": "bun run --cwd packages/luxon benchmark:node",
    "benchmark:memory": "bun run --cwd packages/luxon benchmark:memory",
    "benchmark:memory:node": "bun run --cwd packages/luxon benchmark:memory:node",
    "sync-tests": "bun packages/luxon/scripts/sync-tests.ts",
    "sync-dayjs": "bun packages/dayjs/scripts/sync.ts"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-typescript": "^7.27.0",
    "@types/bun": "^1.4.3",
    "babel-jest": "^29.7.0",
    "dayjs": "^1.11.23",
    "fast-check": "^4.10.2",
    "jest": "^29.7.0",
    "luxon": "^3.7.2",
    "mitata": "^1.0.34",
    "mockdate": "2.0.5",
    "moment": "2.29.2",
    "moment-timezone": "0.5.31",
    "temporal-polyfill": "^1.0.6",
    "typescript": "~7.0.2"
  }
}
